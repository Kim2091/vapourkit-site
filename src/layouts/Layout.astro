---
import '../styles/tailwind.css';
import { base } from '../lib/base';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Vapourkit - Video Restoration for Windows and Linux',
  description = 'Free, open-source video restoration for Windows and Linux with real-time preview, side-by-side comparison, batch processing, and AI support.',
} = Astro.props;

const site = Astro.site?.toString() || Astro.url.origin;
const ogImageUrl = new URL(`${base}og.jpg`, site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="alternate icon" href={`${base}favicon.ico`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="2560" />
    <meta property="og:image:height" content="1540" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <title>{title}</title>
    <script is:inline>
      // Vapourkit's current GUI is dark-only. Keep the landing page aligned
      // with the docs and prevent an old stored theme from changing the chrome.
      document.documentElement.dataset.theme = 'dark';
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="bg-vk-bg text-vk-text antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-sm focus:border focus:border-vk-border/10 focus:bg-vk-elevated focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-vk-text">
      Skip to content
    </a>
    <slot />
  </body>
</html>
