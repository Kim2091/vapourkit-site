---
import Icon from './Icon.astro';
---

<button
  id="vk-scroll-up"
  aria-label="Scroll to top"
  class="fixed bottom-4 right-4 z-50 hidden h-8 w-8 items-center justify-center rounded-sm border border-vk-border/15 bg-vk-surface-2/95 text-vk-text-muted shadow-lg shadow-black/30 backdrop-blur-sm transition-colors hover:border-vk-accent/45 hover:text-vk-accent"
>
  <Icon name="arrow-up" size={14} />
</button>

<script is:inline>
  (() => {
    const up = document.getElementById('vk-scroll-up');
    if (!up) return;
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    up.addEventListener('click', () => window.scrollTo({ top: 0, behavior: prefersReduced ? 'auto' : 'smooth' }));
    const update = () => {
      const isHidden = window.scrollY < 100;
      up.classList.toggle('hidden', isHidden);
      up.classList.toggle('inline-flex', !isHidden);
    };
    let rafId;
    const scheduleUpdate = () => {
      if (!rafId) rafId = requestAnimationFrame(() => { update(); rafId = null; });
    };
    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    update();
  })();
</script>
