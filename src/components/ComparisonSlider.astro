---
interface Props {
  before?: string
  after?: string
}

const { before, after } = Astro.props
---

<div class="comparison-slider relative overflow-hidden rounded-sm border border-vk-border/10 bg-vk-surface-2 p-1 shadow-xl shadow-black/30">
  <div class="relative aspect-video overflow-hidden rounded-sm">
    {
      before && after ? (
        <>
          <img
            src={before}
            alt="Before restoration"
            class="absolute inset-0 h-full w-full object-cover"
            loading="lazy"
            decoding="async"
          />
          <img
            src={after}
            alt="After restoration"
            class="absolute inset-0 h-full w-full object-cover comparison-after"
            style="clip-path: inset(0 50% 0 0);"
            loading="lazy"
            decoding="async"
          />
        </>
      ) : (
        <>
          <div class="absolute inset-0 h-full w-full bg-vk-surface-2"></div>
          <div class="absolute inset-0 h-full w-full bg-black/20 comparison-after" style="clip-path: inset(0 50% 0 0);"></div>
        </>
      )
    }
    <input
      type="range"
      min="0"
      max="100"
      value="50"
      aria-label="Comparison slider"
      class="comparison-input"
    />
    <div class="comparison-overlay" aria-hidden="true"></div>
    <div class="comparison-handle"></div>
  </div>
</div>

<style>
  .comparison-input {
    appearance: none;
    -webkit-appearance: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: transparent;
    z-index: 9;
    cursor: ew-resize;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }
  .comparison-input::-webkit-slider-thumb {
    appearance: none;
    -webkit-appearance: none;
    width: 4px;
    height: 100%;
    background: #3fb9a6;
    cursor: ew-resize;
    border: none;
    border-radius: 0;
    box-shadow: 0 0 12px rgba(63, 185, 166, 0.5);
  }
  .comparison-input::-moz-range-thumb {
    width: 4px;
    height: 100%;
    background: #3fb9a6;
    cursor: ew-resize;
    border: none;
    border-radius: 0;
    box-shadow: 0 0 12px rgba(63, 185, 166, 0.5);
  }
  .comparison-overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
    touch-action: none;
    cursor: ew-resize;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }
  .comparison-handle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #050505;
    border: 3px solid #3fb9a6;
    pointer-events: none;
    z-index: 11;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 16px rgba(63, 185, 166, 0.3);
  }
  .comparison-handle::before,
  .comparison-handle::after {
    content: "";
    display: block;
    width: 2px;
    height: 12px;
    background: #3fb9a6;
    border-radius: 1px;
  }
  .comparison-handle::after {
    margin-left: 4px;
  }
  .comparison-handle::before {
    margin-right: 4px;
  }
</style>

<script is:inline>
  (() => {
    const container = document.currentScript?.parentElement?.querySelector('.comparison-slider');
    const slider = container?.querySelector('.comparison-input');
    const afterEl = container?.querySelector('.comparison-after');
    const handle = container?.querySelector('.comparison-handle');
    const overlay = container?.querySelector('.comparison-overlay');
    if (!slider || !overlay || !container) return;

    const update = (v) => {
      const clamped = Math.max(0, Math.min(100, v));
      slider.value = String(clamped);
      if (afterEl) afterEl.style.clipPath = 'inset(0 ' + (100 - clamped) + '% 0 0)';
      if (handle) handle.style.left = clamped + '%';
    };

    // Keep keyboard support via hidden input
    slider.addEventListener('input', () => {
      update(Number(slider.value));
    });

    // Pointer-driven drag
    const onPointerMove = (e) => {
      const rect = container.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const pct = (x / rect.width) * 100;
      update(pct);
    };

    overlay.addEventListener('pointerdown', (e) => {
      overlay.setPointerCapture(e.pointerId);
      onPointerMove(e);
    });

    overlay.addEventListener('pointermove', (e) => {
      if (!overlay.hasPointerCapture(e.pointerId)) return;
      onPointerMove(e);
    });

    overlay.addEventListener('pointerup', (e) => {
      overlay.releasePointerCapture(e.pointerId);
    });

    overlay.addEventListener('pointercancel', (e) => {
      overlay.releasePointerCapture(e.pointerId);
    });
  })();
</script>
