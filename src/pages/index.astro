---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import FloatingToggle from '../components/FloatingToggle.astro';

const features = [
  {
    icon: 'chip',
    title: 'Dual backends',
    desc: 'TensorRT (NVIDIA) or DirectML (AMD/Intel/NV).',
  },
  {
    icon: 'eye',
    title: 'Real-time preview',
    desc: 'See results as they process.',
  },
  {
    icon: 'split',
    title: 'Compare viewer',
    desc: 'Built-in side-by-side video comparison.',
  },
  {
    icon: 'grid',
    title: 'Batch processing',
    desc: 'Queue multiple videos with workflows.',
  },
  {
    icon: 'code',
    title: 'Custom filters',
    desc: 'Write your own, or install any VapourSynth script/plugin.',
  },
  {
    icon: 'save',
    title: 'Templates & workflows',
    desc: 'Save and share .vkfilter and .vkworkflow files.',
  },
];

const screenshots = [
  { caption: 'Batch processor', src: 'pictures/Batch View.png' },
  { caption: 'Filter panel', src: 'pictures/Filter Panel.png' },
];

const models = [
  { name: 'TFDAT', tag: 'VSR' },
  { name: 'AnimeSharpV4' },
  { name: 'UltraSharpV2' },
];

const filters = [
  { name: 'vs-jetpack' },
  { name: 'TemporalFix' },
  { name: 'QTGMC' },
  { name: 'RIFE' },
];

const sysreqs = [
  { label: 'OS', value: 'Windows 10/11 (x64)' },
  { label: 'RAM', value: '8 GB +' },
  { label: 'Storage', value: '5 GB min · 10 GB recommended' },
  { label: 'GPU', value: 'NVIDIA 16xx+ or any DX12-capable card' },
  { label: 'VRAM', value: '6 GB +' },
];

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---

<Layout>
  <!-- Top nav -->
  <header
    class="sticky top-0 z-40 border-b border-vk-border/10 bg-vk-bg/75 backdrop-blur-md"
  >
    <div class="mx-auto max-w-6xl px-6">
      <!-- Main row: real destinations -->
      <div class="flex items-center justify-between py-3.5">
        <a href={base} class="flex items-center gap-2.5">
          <img src={`${base}favicon.svg`} alt="" class="h-6 w-6" />
          <strong class="text-sm">Vapourkit</strong>
        </a>
        <nav class="flex items-center gap-3 text-sm text-vk-text-muted md:gap-6">
          <a href={`${base}introduction/`} class="hover:text-vk-text transition-colors">Docs</a>
          <a href={`${base}reference/troubleshooting/`} class="hidden hover:text-vk-text transition-colors md:inline">FAQ</a>
          <div class="flex items-center gap-2">
            <a
              href="https://github.com/Kim2091/vapourkit"
              target="_blank"
              rel="noopener"
              aria-label="GitHub"
              class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-vk-border/10 text-vk-text-muted transition-colors hover:border-vk-border/20 hover:text-vk-text"
            >
              <Icon name="github" size={15} />
            </a>
            <a
              href="https://discord.gg/uYKMn2hGwB"
              target="_blank"
              rel="noopener"
              aria-label="Discord"
              class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-vk-border/10 text-vk-text-muted transition-colors hover:border-vk-border/20 hover:text-vk-text"
            >
              <Icon name="discord" size={15} />
            </a>
            <a
              href="https://ko-fi.com/kim20913944"
              target="_blank"
              rel="noopener"
              aria-label="Ko-fi"
              class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-vk-border/10 text-vk-text-muted transition-colors hover:border-vk-border/20 hover:text-vk-text"
            >
              <Icon name="coffee" size={15} />
            </a>
          </div>
          <a
            href="https://ko-fi.com/s/2e5ebd456d"
            target="_blank"
            rel="noopener"
            class="hidden rounded-md border border-vk-brand-purple/35 bg-vk-elevated px-3.5 py-1.5 font-medium text-vk-text transition-colors hover:border-vk-brand-purple/65 md:inline-block"
          >
            Download
          </a>
        </nav>
      </div>
      <!-- Subheader: in-page anchors -->
      <nav
        class="flex h-9 items-center justify-start gap-7 overflow-x-auto whitespace-nowrap border-t border-vk-border/8 text-[11px] uppercase tracking-[0.08em] text-vk-text-subtle [-ms-overflow-style:none] [scrollbar-width:none] md:justify-center md:overflow-x-visible [&::-webkit-scrollbar]:hidden"
      >
        <a href="#features" class="hover:text-vk-text-muted transition-colors">Features</a>
        <a href="#tour" class="hover:text-vk-text-muted transition-colors">Screenshots</a>
        <a href="#filters" class="hover:text-vk-text-muted transition-colors">Filters</a>
        <a href="#models" class="hover:text-vk-text-muted transition-colors">Models</a>
        <a href="#community" class="hover:text-vk-text-muted transition-colors">Community</a>
      </nav>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden px-6 py-20 lg:py-28 text-center">
      <div
        class="pointer-events-none absolute inset-0"
        style="background: radial-gradient(ellipse 60% 50% at 50% 30%, var(--vk-hero-glow-1), transparent 70%), radial-gradient(ellipse 40% 35% at 50% 30%, var(--vk-hero-glow-2), transparent 70%);"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-3xl">
        <h1 class="text-4xl font-bold leading-[1.1] tracking-tight text-vk-text sm:text-5xl lg:text-[3rem]">
          Restore and upscale video,<br />
          <span class="font-normal text-vk-text-muted">beautifully.</span>
        </h1>
        <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-vk-text-muted">
          Free, open source video restoration for Windows. Real-time preview,
          side-by-side comparison, batch processing, and AI support.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a
            href="https://ko-fi.com/s/2e5ebd456d"
            target="_blank"
            rel="noopener"
            class="rounded-lg border border-vk-brand-purple/40 bg-vk-elevated px-6 py-2.5 text-sm font-medium text-vk-text transition-colors hover:border-vk-brand-purple/70"
          >
            Download Free
          </a>
          <a
            href="https://github.com/Kim2091/vapourkit"
            target="_blank"
            rel="noopener"
            class="flex items-center gap-2 rounded-lg border border-vk-border/15 px-6 py-2.5 text-sm text-vk-text transition-colors hover:border-vk-border/25"
          >
            <Icon name="github" size={16} />
            <span>View on GitHub</span>
          </a>
        </div>

        <!-- Hero screenshot -->
        <div class="mx-auto mt-14 max-w-3xl rounded-xl border border-vk-border/10 bg-vk-surface-2 p-1.5">
          <img
            src={`${base}pictures/Main Screen.png`}
            alt="Vapourkit main upscale view"
            class="block h-auto w-full rounded-md"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="border-t border-vk-border/8 px-6 py-16">
      <div class="mx-auto max-w-6xl">
        <div class="mb-9 text-center">
          <div
            class="mb-1.5 text-[11px] uppercase tracking-[0.1em] text-vk-text-subtle"
          >
            Features
          </div>
          <h2 class="text-2xl font-semibold text-vk-text sm:text-[1.625rem]">
            Everything you need to upscale, compare, and ship.
          </h2>
        </div>
        <div
          class="grid grid-cols-1 overflow-hidden rounded-xl border border-vk-border/8 bg-vk-border/8 gap-px sm:grid-cols-2 md:grid-cols-3"
        >
          {
            features.map((f) => (
              <div class="bg-vk-surface-2 p-6">
                <div class="mb-3.5 flex h-8 w-8 items-center justify-center rounded-md border border-vk-brand-cyan/30 bg-vk-brand-cyan/8">
                  <Icon name={f.icon as any} size={16} stroke="var(--sl-color-accent, #06b6d4)" />
                </div>
                <strong class="text-sm text-vk-text">{f.title}</strong>
                <p class="mt-1.5 text-xs leading-relaxed text-vk-text-muted">{f.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Before / After -->
    <section class="px-6 py-16">
      <div class="mx-auto max-w-6xl">
        <div class="mb-7 text-center">
          <div
            class="mb-1.5 text-[11px] uppercase tracking-[0.1em] text-vk-text-subtle"
          >
            Before / After
          </div>
          <h2 class="text-2xl font-semibold text-vk-text sm:text-[1.625rem]">
            See the difference.
          </h2>
        </div>
        <div class="space-y-6">
          <figure
            class="overflow-hidden rounded-xl border border-vk-border/10 bg-vk-surface-2"
          >
            <div class="aspect-[21/9]">
              <iframe
                src="https://www.youtube-nocookie.com/embed/bQ4f-w2gub0?rel=0"
                title="SpongeBob Season 1 remaster"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                class="block h-full w-full"></iframe>
            </div>
            <figcaption class="px-3 py-2 text-[11px] text-vk-text-subtle">
              SpongeBob Season 1 remaster
            </figcaption>
          </figure>
          <figure
            class="overflow-hidden rounded-xl border border-vk-border/10 bg-vk-surface-2"
          >
            <div class="aspect-[21/9]">
              <iframe
                src="https://www.youtube-nocookie.com/embed/dPt9NtzQ_04?rel=0"
                title="VHS Restoration Sample"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                class="block h-full w-full"></iframe>
            </div>
            <figcaption class="px-3 py-2 text-[11px] text-vk-text-subtle">
              VHS Restoration Sample
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Tour -->
    <section id="tour" class="border-t border-vk-border/8 px-6 py-16">
      <div class="mx-auto max-w-6xl">
        <div class="mb-7 text-center">
          <div
            class="mb-1.5 text-[11px] uppercase tracking-[0.1em] text-vk-text-subtle"
          >
            Tour
          </div>
          <h2 class="text-2xl font-semibold text-vk-text sm:text-[1.625rem]">
            A look around.
          </h2>
        </div>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          {
            screenshots.map((s) => (
              <figure class="overflow-hidden rounded-lg border border-vk-border/10 bg-vk-surface-2">
                <img
                  src={`${base}${s.src}`}
                  alt={s.caption}
                  class="block aspect-video w-full object-contain"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption class="px-3 py-2 text-[11px] text-vk-text-subtle">
                  {s.caption}
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Filters -->
    <section id="filters" class="border-t border-vk-border/8 px-6 py-16">
      <div class="mx-auto max-w-6xl">
        <div class="mb-7 text-center">
          <div
            class="mb-1.5 text-[11px] uppercase tracking-[0.1em] text-vk-text-subtle"
          >
            Filters
          </div>
          <h2 class="text-2xl font-semibold text-vk-text sm:text-[1.625rem]">
            Bundled filters, or write your own.
          </h2>
        </div>
        <div class="flex flex-wrap justify-center gap-2">
          {
            filters.map((f) => (
              <div class="rounded-md border border-vk-border/10 bg-vk-surface-2 px-4 py-2 text-sm text-vk-text">
                {f.name}
              </div>
            ))
          }
          <div
            class="rounded-md border border-dashed border-vk-border/15 px-4 py-2 text-sm text-vk-text-muted"
          >
            + Custom filters
          </div>
        </div>
      </div>
    </section>

    <!-- Models -->
    <section id="models" class="border-t border-vk-border/8 px-6 py-16">
      <div class="mx-auto max-w-6xl">
        <div class="mb-7 text-center">
          <div
            class="mb-1.5 text-[11px] uppercase tracking-[0.1em] text-vk-text-subtle"
          >
            Models
          </div>
          <h2 class="text-2xl font-semibold text-vk-text sm:text-[1.625rem]">
            Bundled models, or bring your own.
          </h2>
        </div>
        <div class="flex flex-wrap justify-center gap-2">
          {
            models.map((m) => (
              <div class="rounded-md border border-vk-border/10 bg-vk-surface-2 px-4 py-2 text-sm text-vk-text">
                {m.name}
                {m.tag && (
                  <span class="ml-2 text-[11px] text-vk-text-subtle">{m.tag}</span>
                )}
              </div>
            ))
          }
          <div
            class="rounded-md border border-dashed border-vk-border/15 px-4 py-2 text-sm text-vk-text-muted"
          >
            + Custom ONNX
          </div>
        </div>
      </div>
    </section>

    <!-- System requirements -->
    <section class="border-t border-vk-border/8 px-6 py-16">
      <div class="mx-auto max-w-6xl">
        <div class="mb-7 text-center">
          <div
            class="mb-1.5 text-[11px] uppercase tracking-[0.1em] text-vk-text-subtle"
          >
            System Requirements
          </div>
          <h2 class="text-2xl font-semibold text-vk-text sm:text-[1.625rem]">
            Hardware needs.
          </h2>
        </div>
        <div
          class="mx-auto max-w-xl rounded-xl border border-vk-border/10 bg-vk-surface-2 p-7 text-sm text-vk-text-muted"
        >
          {
            sysreqs.map((r, i) => (
              <div
                class={`grid grid-cols-[auto_1fr] items-baseline gap-x-4 py-2 sm:gap-x-6 ${i < sysreqs.length - 1 ? 'border-b border-vk-border/5' : ''}`}
              >
                <span>{r.label}</span>
                <span class="text-right text-vk-text">{r.value}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Community + Support -->
    <section id="community" class="border-t border-vk-border/8 px-6 py-16">
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 md:grid-cols-2 md:gap-0 md:divide-x md:divide-vk-border/8">
        <div class="text-center md:px-8">
          <div
            class="mb-1.5 text-[11px] uppercase tracking-[0.1em] text-vk-text-subtle"
          >
            Community
          </div>
          <h2 class="text-2xl font-semibold text-vk-text sm:text-[1.625rem]">
            Join the Discord.
          </h2>
          <p class="mx-auto mt-3 max-w-md text-sm text-vk-text-muted">
            Share your results, find workflow files shared by others, get help, or request features!
          </p>
          <a
            href="https://discord.gg/uYKMn2hGwB"
            target="_blank"
            rel="noopener"
            class="mt-6 inline-flex items-center gap-2 rounded-lg border border-indigo-500/40 bg-vk-surface-2 px-6 py-2.5 text-sm font-medium text-vk-text transition-colors hover:border-indigo-500/70"
          >
            <Icon name="discord" size={16} />
            <span>Join Discord</span>
          </a>
        </div>
        <div class="text-center md:px-8">
          <div
            class="mb-1.5 text-[11px] uppercase tracking-[0.1em] text-vk-text-subtle"
          >
            Support
          </div>
          <h2 class="text-2xl font-semibold text-vk-text sm:text-[1.625rem]">
            Vapourkit is free. Tips help.
          </h2>
          <p class="mx-auto mt-3 max-w-md text-sm text-vk-text-muted">
            Donations support my work and help fund development!
          </p>
          <a
            href="https://ko-fi.com/kim20913944"
            target="_blank"
            rel="noopener"
            class="mt-6 inline-flex items-center gap-2 rounded-lg border border-pink-500/40 px-6 py-2.5 text-sm font-medium text-pink-500 transition-colors hover:border-pink-500/70 dark:text-pink-300"
          >
            <Icon name="coffee" size={14} />
            <span>Ko-fi</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Credits footer -->
    <footer
      class="border-t border-vk-border/8 px-6 py-7 text-center text-[11px] text-vk-text-subtle"
    >
      Copyright © Kim2091
    </footer>
  </main>

  <FloatingToggle />

</Layout>
